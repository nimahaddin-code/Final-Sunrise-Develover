    "A big, soft, round brush. It spreads blush lightly, so you get a soft glow with no hard edges." : {
      "comment" : "Text for the brush tip.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brush besar yang bulat dan lembut. Ratain blush tipis-tipis, jadi glow-nya halus tanpa garis tegas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一支又大又软的圆头刷。它能把腮红轻轻扫开，妆感柔和，没有生硬的边缘。"
          }
        }
      }
    },
    "A bullet or a liquid one" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yang stik atau yang cair"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "口红管或唇釉都可以"
          }
        }
      }
    },
    "A clean brush" : {
      "comment" : "Blush look description or makeup kit item shown before the tutorial.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brush yang bersih"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一支干净的刷子"
          }
        }
      }
    },
    "A felt-tip pen is easiest to control" : {
      "comment" : "Text for a product that's a felt-tip pen for eyeliner.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yang model spidol paling gampang dikontrol"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "软头眼线笔最好控制"
          }
        }
      }
    },
    "A flat lid with little or no visible crease." : {
      "comment" : "Summary of the eyelid type \"monolid\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kelopak rata, lipatannya hampir nggak kelihatan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "眼皮平整，几乎看不到褶皱。"
          }
        }
      }
    },
    "A fresh, rosy flush on the apples of your cheeks that makes your face look softer and younger." : {
      "comment" : "Blush look description or makeup kit item shown before the tutorial.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rona pink segar di pipi bagian depan, bikin wajahmu kelihatan lebih fresh dan imut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在苹果肌上扫出清新的红润感，让脸看起来更柔和、更年轻。"
          }
        }
      }
    },
    "A gentle cleansing water. Put a little on a cotton pad or bud and wipe a mistake away." : {
      "comment" : "Text for the micellar water tip.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Air pembersih yang lembut. Tuang dikit ke kapas atau cotton bud, terus hapus yang meleset."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一款温和的卸妆水。在化妆棉或棉签上倒一点，就能把画错的地方擦掉。"
          }
        }
      }
    },
    "A light layer on top helps the blush last longer." : {
      "comment" : "Blush look description or makeup kit item shown before the tutorial.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tipis-tipis aja di atasnya, biar blush-nya awet seharian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最后薄薄扫一层，腮红会更持久。"
          }
        }
      }
    },
    "A liner shape that suits your eyes." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bentuk eyeliner yang pas buat matamu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "适合你眼型的眼线。"
          }
        }
      }
    },
    "A lip colour and shape that suits you." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Warna dan bentuk bibir yang pas buat kamu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "适合你的唇色和唇形。"
          }
        }
      }
    },
    "A little guidance. A glow that's yours." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A little guidance. A glow that's yours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sedikit panduan. Glow yang khas kamu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一点点指引，属于你的好气色。"
          }
        }
      }
    },
    "A small spiral brush, like a clean mascara wand. It combs brow hairs up and softens pencil lines." : {
      "comment" : "Text for the brow spoolie tooltip.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sikat spiral kecil, kayak sikat maskara yang bersih. Buat nyisir bulu alis ke atas dan nge-blend garis pensil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一支小螺旋刷，就像干净的睫毛膏刷头。它能把眉毛向上梳，并柔化眉笔的线条。"
          }
        }
      }
    },
    "A soft blush brush" : {
      "comment" : "Blush look description or makeup kit item shown before the tutorial.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brush blush yang lembut"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一支柔软的腮红刷"
          }
        }
      }
    },
    "A soft flush placed right for your cheeks." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rona blush lembut di posisi yang pas buat pipimu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "位置刚好的柔和腮红。"
          }
        }
      }
    },
    "A soft wash of colour on your cheeks, blended out so no edge shows." : {
      "comment" : "Blush look description or makeup kit item shown before the tutorial.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rona lembut di pipi, di-blend sampai nggak ada garis tepinya."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在脸颊上轻扫一层柔和的颜色，晕开到看不出边缘。"
          }
        }
      }
    },
    "A thin pencil for filling in brows. Pick a shade a little lighter than your hair so it looks natural." : {
      "comment" : "Text for the brow pencil product.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pensil tipis buat ngisi alis. Pilih warna yang sedikit lebih terang dari rambutmu biar natural."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一支用来填补眉毛的细眉笔。选比发色浅一点的颜色，看起来更自然。"
          }
        }
      }
    },
    "A warm wash across both cheeks and the top of your nose, like you just came back from the sun." : {
      "comment" : "Blush look description or makeup kit item shown before the tutorial.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rona hangat di kedua pipi sampai ke hidung, kayak habis main di pantai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "从两颊到鼻梁扫上一层暖色，像刚晒完太阳回来一样。"
          }
        }
      }
    },
    "A wider forehead that tapers down to a narrow jaw and a pointed chin." : {
      "comment" : "Summary description of the \"Heart\" face shape.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dahi lebih lebar, makin ke bawah makin ramping sampai dagu yang lancip."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "额头较宽，向下收窄到较窄的下颌和尖下巴。"
          }
        }
      }
    },
    "Actual camera captures. Different framing or lighting can affect comparison. No beauty scoring or automatic assessment." : {
      "comment" : "-Nimah: MVP source copy.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actual camera captures. Different framing or lighting can affect comparison. No beauty scoring or automatic assessment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hasil tangkapan kamera asli. Framing atau cahaya yang berbeda bisa memengaruhi perbandingan. Tanpa penilaian kecantikan atau penilaian otomatis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这是相机实拍的照片。构图或光线不同会影响对比。不做颜值打分，也不做自动评估。"
          }
        }
      }
    },

        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kamera menampilkan makeup di wajahmu secara langsung dan bisa memotret palet makeup agar kamu bisa memilih warna. Tidak ada yang disimpan atau diunggah."
          }
        }
      }
    },

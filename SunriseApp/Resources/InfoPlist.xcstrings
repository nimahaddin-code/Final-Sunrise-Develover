    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera shows makeup on your face live and can photograph a makeup palette so you can pick a colour. Nothing is saved or uploaded."
